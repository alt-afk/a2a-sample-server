# Copy to .env (git-ignored) and paste your Google AI Studio keys.

# One key for everything.
GOOGLE_API_KEY=paste-your-ai-studio-key

# Optional: a different key for the server, so its calls count against a
# different per-minute quota. Falls back to GOOGLE_API_KEY.
# SERVER_GOOGLE_API_KEY=paste-another-key

# Pick models your key can call: python list_models.py. Lite models have higher free-tier limits.
CLIENT_MODEL=gemini-3.5-flash-lite
SERVER_MODEL=gemini-3.5-flash-lite

# Where the remote agent is served, and where the client looks for it.
SERVER_HOST=localhost
SERVER_PORT=8002
SERVER_URL=http://localhost:8002
